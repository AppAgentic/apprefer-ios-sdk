/* Primary button under the usage terms that uploads and submits the selected photo or video. Submitting means agreeing to the terms shown. */
"support.testimonial.submit" = "Υποβολή";
/* Progress while uploading. {percent} = 0-100. */
"support.testimonial.uploading" = "Γίνεται μεταφόρτωση… {percent}%";
/* Shown after the upload while the server checks the file. */
"support.testimonial.checking" = "Γίνεται έλεγχος…";
/* Title after a successful share. */
"support.testimonial.done" = "Ευχαριστούμε που το μοιράστηκες!";
/* After sharing, while the app hasn't confirmed the reward yet. Never promise delivery, shipping or an email. */
"support.testimonial.rewardPending" = "Την κέρδισες. Θα εμφανιστεί εδώ ως επιβεβαιωμένη μόλις αποδοθεί.";
/* After the app confirmed the reward (gifts, discounts, merchandise or anything handled by the app). Generic: no shipping or email promise. */
"support.testimonial.rewardDone" = "Η ανταμοιβή σου επιβεβαιώθηκε.";
/* After the app confirmed an in-account reward (credits, coach answers, subscription time). */
"support.testimonial.rewardDone.account" = "Η ανταμοιβή σου προστέθηκε στον λογαριασμό σου.";
/* After sharing, when the app's confirmation failed or took too long. The support team can retry it from their inbox. */
"support.testimonial.rewardDelayed" = "Η ανταμοιβή σου δεν έχει επιβεβαιωθεί ακόμη. Η υποστήριξη το βλέπει και μπορεί να τη στείλει ξανά.";
/* After sharing, when this customer was already rewarded for this campaign. */
"support.testimonial.rewardNotEligible" = "Έχεις ήδη συμμετάσχει σε αυτό, οπότε αυτή τη φορά δεν υπάρχει νέα ανταμοιβή.";
/* Button to decline the request. */
"support.testimonial.decline" = "Όχι, ευχαριστώ";
/* Button to decline and never be asked again in this app. */
"support.testimonial.dontAsk" = "Μη με ξαναρωτήσεις";
/* Closes the capture screen without sharing. */
"support.testimonial.cancel" = "Ακύρωση";
/* Shown on a request card or screen that expired, was withdrawn or belongs to another account. */
"support.testimonial.unavailable" = "Αυτό το αίτημα δεν είναι πια διαθέσιμο";
/* Error when the chosen video is too long. {seconds} = a whole number. */
"support.testimonial.tooLong" = "Τα βίντεο μπορούν να διαρκούν έως {seconds} δευτερόλεπτα.";
/* Error when the chosen file is over the size limit. */
"support.testimonial.tooLarge" = "Αυτό το αρχείο είναι πολύ μεγάλο για κοινοποίηση.";
/* Error when the upload or share failed. Nothing was shared; the retry button follows. */
"support.testimonial.failed" = "Δεν ήταν δυνατή η κοινοποίηση και δεν στάλθηκε τίποτα. Έλεγξε τη σύνδεσή σου και δοκίμασε ξανά.";
/* Button after sharing to withdraw permission for public use. */
"support.testimonial.withdraw" = "Διακοπή δημόσιας χρήσης";
/* VoiceOver/TalkBack label of the preview. */
"support.testimonial.a11y.preview" = "Η φωτογραφία ή το βίντεο που επέλεξες";
